# Copy this to .env and fill in your actual database connection.

# --- Option A: docker-compose (included in this repo) ---
# Run `docker compose up -d`, then use this connection string as-is —
# it matches the credentials set in docker-compose.yml.
DATABASE_URL="postgresql://family_tree:family_tree@localhost:5432/family_tree?schema=public"

# --- Option B: your own local Postgres install ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_tree?schema=public"

# --- Option C: a hosted free tier (Neon, Supabase, Railway) ---
# Paste the connection string they give you here instead.
